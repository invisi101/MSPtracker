# Copy to .env (kept private, never committed) and fill in the key.
# Optional: an Anthropic API key. Usually entered in the app instead (welcome screen or Settings).
ANTHROPIC_API_KEY=
# Where the app listens. Keep HOST on 127.0.0.1 so only this computer can reach it.
PORT=7797
HOST=127.0.0.1
ORIGIN=http://localhost:7797
# Where the database and uploaded photos are kept. Use an absolute path.
DATA_DIR=
# Optional: the AI model for the assistant and chef.
# COACH_MODEL=claude-opus-4-8
